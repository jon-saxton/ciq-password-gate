# Single gate (use when you only need one protected link)
ACCESS_PASSWORD=your-secret-password
REDIRECT_URL=https://example.com/protected-resource

# Multiple gates — JSON map of gate ID → { password, url }
# ACCESS_GATES={"partner-deck":{"password":"secret1","url":"https://..."},"internal":{"password":"secret2","url":"https://..."}}

# Comma-separated origins allowed to call the API (for staging + production)
ALLOWED_ORIGINS=https://www.captivateiq.com,https://captivateiq.com,https://captivateiq.webflow.io
